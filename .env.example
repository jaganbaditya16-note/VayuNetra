# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only persistence and integrity
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
VAYUNETRA_INTEGRITY_SECRET=replace-with-at-least-32-random-bytes

# AI / environmental providers
GEMINI_API_KEY=replace-with-server-only-gemini-key
EARTH_ENGINE_PROJECT_ID=your-earth-engine-project-id

# Optional runtime
PORT=8080
